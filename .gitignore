# Live runtime environment — contains real credentials (PAT, tokens). The
# tracked template lives at backend/deploy/cronomicon.env.example.
backend/cronomicon.env
cronomicon.env
backend/deploy/secrets

# Compiled binaries — built locally by backend/Makefile (`-o backend/cronomicon`
# and the runner); the Docker image builds its own inside the container. Local
# builds keep working; these outputs are just no longer tracked.
backend/cronomicon
backend/cronomicon-runner
backend/bin
frontend/tsconfig.tsbuildinfo

