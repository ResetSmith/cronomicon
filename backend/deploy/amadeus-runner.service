# systemd unit for the Cronomicon runner agent (R7.1).
#
# Runs amadeus-runner as a dedicated non-root service that reads its config from
# an env file (/etc/amadeus-runner/runner.env — see amadeus-runner.env.example)
# and persists its identity under /var/lib/amadeus-runner so a restart resumes
# the same runners row (R2.4 / D4) instead of orphaning it.
#
# Install:
#   sudo useradd --system --home-dir /var/lib/amadeus-runner \
#                --shell /usr/sbin/nologin amadeus-runner
#   sudo install -d -o amadeus-runner -g amadeus-runner -m 0750 /var/lib/amadeus-runner
#   sudo install -d -m 0750 /etc/amadeus-runner
#   sudo install -m 0640 amadeus-runner.env.example /etc/amadeus-runner/runner.env  # then edit
#   sudo install -m 0755 amadeus-runner /usr/local/bin/amadeus-runner
#   sudo install -m 0644 amadeus-runner.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now amadeus-runner
#
# Drain before stopping a runner (operators: use the Settings → Runners "Drain"
# action so active runs finish; the agent honours drain on its next poll). See
# deploy/manage-runner.md "Manage day-to-day".

[Unit]
Description=Cronomicon runner agent
Documentation=file:///usr/share/doc/amadeus-runner/install-runner.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amadeus-runner
Group=amadeus-runner

# Config: the env file carries CRONOMICON_RUNNER_* (server URL, registration token,
# name, capabilities, inventory mode, key custody, etc.). A "-" prefix lets the
# service start even if the file is absent on first install, but it WILL fail
# fast in the agent's own validation until the required vars are set.
EnvironmentFile=-/etc/amadeus-runner/runner.env

# Optional Vault Agent sidecar (deploy/vault-agent/): if the sidecar is
# installed it renders NAME-referenced secrets (e.g. an Ansible become password)
# here from Vault; the "-" makes this a no-op when the sidecar is absent, so this
# line is non-breaking for runners that provision secrets by hand. systemd reads
# it only at start — restart the runner to pick up a rotated secret.
EnvironmentFile=-/etc/amadeus-runner/secrets.env

# Identity persistence — keep this consistent with the env file value.
Environment=CRONOMICON_RUNNER_IDENTITY_FILE=/var/lib/amadeus-runner/identity.json
WorkingDirectory=/var/lib/amadeus-runner

ExecStart=/usr/local/bin/amadeus-runner

# Graceful drain on stop: SIGTERM makes the agent stop claiming new work and let
# active runs finish. Give long-running ansible/terraform plays time to wind down.
KillSignal=SIGTERM
TimeoutStopSec=300

Restart=on-failure
RestartSec=10s

# ── Hardening ────────────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Only the identity/key state directory is writable; everything else is read-only
# (ProtectSystem=strict). /var/lib/amadeus-runner is created and owned by us.
StateDirectory=amadeus-runner
ReadWritePaths=/var/lib/amadeus-runner

# Network: the agent only needs outbound HTTPS to the server and SSH to targets
# (IPv4/IPv6/UNIX for local toolchains). No need for exotic address families.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# ── Tier 2 sandbox (ansible-update.md Phase 5, §6.3) ─────────────────────────
# Ansible/terraform runs execute as CHILDREN of this unit, so they inherit the
# hardening above (ProtectSystem=strict, NoNewPrivileges, the syscall filter,
# PrivateTmp). The agent additionally wraps each local-toolchain run in a per-run
# `systemd-run --scope` transient cgroup for resource caps (configure with
# -sandbox-memory-max / -sandbox-cpu-quota / -sandbox-tasks-max, or their
# CRONOMICON_RUNNER_SANDBOX_* env). Sandbox availability is probed at startup and
# reported per-run; where no usable systemd manager exists the run is executed
# and reported UNSANDBOXED. Creating scopes requires the agent to reach the
# systemd manager — if the directives above prove too restrictive for that on
# your host, the runs still inherit this unit's sandbox; they just lose the
# per-run resource caps.
#
# ── Egress allowlist (P5 — opt-in, commented) ────────────────────────────────
# Restrict where this runner (and its ansible/terraform children) may connect.
# Enforcement is left commented until agency-zone address maps are stable (P5):
# uncomment and fill in the CIDRs for your Cronomicon server, galaxy source/mirror,
# and the target segments this runner manages. IPAddressDeny=any first, then
# allow only what is needed.
#   IPAddressDeny=any
#   IPAddressAllow=localhost
#   IPAddressAllow=10.0.0.0/8          # example: internal target + server segment
#   IPAddressAllow=<galaxy-mirror-cidr> # or omit if -galaxy-server is on-segment

[Install]
WantedBy=multi-user.target
