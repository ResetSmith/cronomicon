# systemd unit for the Cronomicon runner agent (R7.1).
#
# Runs cronomicon-runner as a dedicated non-root service that reads its config from
# an env file (/etc/cronomicon-runner/runner.env — see cronomicon-runner.env.example)
# and persists its identity under /var/lib/cronomicon-runner so a restart resumes
# the same runners row (R2.4 / D4) instead of orphaning it.
#
# Install:
#   sudo useradd --system --home-dir /var/lib/cronomicon-runner \
#                --shell /usr/sbin/nologin cronomicon-runner
#   sudo install -d -o cronomicon-runner -g cronomicon-runner -m 0750 /var/lib/cronomicon-runner
#   sudo install -d -m 0750 /etc/cronomicon-runner
#   sudo install -m 0640 cronomicon-runner.env.example /etc/cronomicon-runner/runner.env  # then edit
#   sudo install -m 0755 cronomicon-runner /usr/local/bin/cronomicon-runner
#   sudo install -m 0644 cronomicon-runner.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cronomicon-runner
#
# Drain before stopping a runner (operators: use the Settings → Runners "Drain"
# action so active runs finish; the agent honours drain on its next poll). See
# deploy/manage-runner.md "Manage day-to-day".

[Unit]
Description=Cronomicon runner agent
Documentation=file:///usr/share/doc/cronomicon-runner/install-runner.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cronomicon-runner
Group=cronomicon-runner

# Config: the env file carries CRONOMICON_RUNNER_* (server URL, registration token,
# name, capabilities, inventory mode, key custody, etc.). A "-" prefix lets the
# service start even if the file is absent on first install, but it WILL fail
# fast in the agent's own validation until the required vars are set.
EnvironmentFile=-/etc/cronomicon-runner/runner.env

# Optional Vault Agent sidecar (if you run one on the host): if the sidecar is
# installed it renders NAME-referenced secrets (e.g. an Ansible become password)
# here from Vault; the "-" makes this a no-op when the sidecar is absent, so this
# line is non-breaking for runners that provision secrets by hand. systemd reads
# it only at start — restart the runner to pick up a rotated secret.
EnvironmentFile=-/etc/cronomicon-runner/secrets.env

# Identity persistence — keep this consistent with the env file value.
Environment=CRONOMICON_RUNNER_IDENTITY_FILE=/var/lib/cronomicon-runner/identity.json
WorkingDirectory=/var/lib/cronomicon-runner

ExecStart=/usr/local/bin/cronomicon-runner

# Graceful drain on stop: SIGTERM makes the agent stop claiming new work and let
# active runs finish. Give long-running ansible/terraform plays time to wind down.
KillSignal=SIGTERM
TimeoutStopSec=300

Restart=on-failure
RestartSec=10s

# ── Hardening ────────────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A filtered call answers EPERM instead of killing the calling thread. The
# agent is a Go program, and Go's PATH lookup first tries a system call
# (faccessat2) that an older systemd's @system-service list does not know
# (239, on RHEL 8, for one). Killed, that thread never answers: the lookup
# hangs, the agent finds no bash, perl or python, and it refuses to start.
# Told EPERM, Go falls back to the older call.
SystemCallErrorNumber=EPERM

# Only the identity/key state directory is writable; everything else is read-only
# (ProtectSystem=strict). /var/lib/cronomicon-runner is created and owned by us.
StateDirectory=cronomicon-runner
# Without this systemd resets the state directory to 0755 at every start, and
# another user on the machine (a second agent's, for one) can list it.
StateDirectoryMode=0750
ReadWritePaths=/var/lib/cronomicon-runner

# Network: the agent only needs outbound HTTPS to the server and SSH to targets
# (IPv4/IPv6/UNIX for local toolchains). No need for exotic address families.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# ── Tier 2 sandbox (ansible-update.md Phase 5, §6.3) ─────────────────────────
# Ansible/terraform runs execute as CHILDREN of this unit, so they inherit the
# hardening above (ProtectSystem=strict, NoNewPrivileges, the syscall filter,
# PrivateTmp). The agent additionally wraps each local-toolchain run in a per-run
# `systemd-run --scope` transient cgroup for resource caps (configure with
# -sandbox-memory-max / -sandbox-cpu-quota / -sandbox-tasks-max, or their
# CRONOMICON_RUNNER_SANDBOX_* env). Sandbox availability is probed at startup and
# reported per-run; where the agent cannot create a scope the run is executed
# and reported UNSANDBOXED.
#
# UNDER THIS UNIT IT CANNOT. Creating a scope is a request to the system
# manager that polkit refuses to a user who is not root ("Interactive
# authentication required"), and User= above is not root. The hardening is not
# the cause (root creates a scope under all of it), and the permission that
# would grant it is the one to manage units: more than an agent should hold.
# So with this unit every local-toolchain run inherits the hardening and has
# NO resource cap of its own: the -sandbox-* settings do nothing and the agent
# does not advertise `sandboxed`.
#
# ── Resource limits ──────────────────────────────────────────────────────────
# What does work is a limit on this unit: the agent and everything it runs,
# together. On a machine with several agents, give each one limits so that no
# agency's run can starve the others. runner-install.sh writes them with
# --memory-max, --cpu-quota and --tasks-max; on an installed agent,
# `systemctl set-property cronomicon-runner.service MemoryMax=4G …` sets them
# without a restart. None is set by default.
#   MemoryMax=4G
#   CPUQuota=200%
#   TasksMax=1024
#
# ── Egress allowlist (P5 — opt-in, commented) ────────────────────────────────
# Restrict where this runner (and its ansible/terraform children) may connect.
# Enforcement is left commented until agency-zone address maps are stable (P5):
# uncomment and fill in the CIDRs for your Cronomicon server, galaxy source/mirror,
# and the target segments this runner manages. IPAddressDeny=any first, then
# allow only what is needed.
#   IPAddressDeny=any
#   IPAddressAllow=localhost
#   IPAddressAllow=10.0.0.0/8          # example: internal target + server segment
#   IPAddressAllow=<galaxy-mirror-cidr> # or omit if -galaxy-server is on-segment

[Install]
WantedBy=multi-user.target
