# systemd unit for the Cronomicon runner's Vault Agent sidecar (opt-in stopgap).
#
# Authenticates to Vault with an AppRole and renders
# /etc/amadeus-runner/secrets.env, which amadeus-runner.service sources at start
# (via its optional `EnvironmentFile=-/etc/amadeus-runner/secrets.env` line).
# See deploy/vault-agent/README.md.
#
# Install:
#   sudo install -d -m 0750 -o root -g amadeus-runner /etc/amadeus-runner/vault
#   sudo install -m 0640 vault-agent.hcl   /etc/amadeus-runner/vault/vault-agent.hcl
#   sudo install -m 0640 secrets.env.ctmpl /etc/amadeus-runner/vault/secrets.env.ctmpl
#   sudo install -m 0644 amadeus-vault-agent.service /etc/systemd/system/
#   # place role_id / secret_id under /etc/amadeus-runner/vault (0600 root)
#   sudo systemctl daemon-reload && sudo systemctl enable --now amadeus-vault-agent

[Unit]
Description=Cronomicon runner Vault Agent sidecar
Documentation=file:///usr/share/doc/amadeus-runner/vault-agent/README.md
After=network-online.target
Wants=network-online.target
# The runner starts cleanly without us (EnvironmentFile is optional), but if both
# are enabled, render before the runner so the first start already sees secrets.
Before=amadeus-runner.service

[Service]
Type=simple
# Runs as root so it can write the rendered file as root:amadeus-runner into the
# read-only /etc tree (see ReadWritePaths). The Vault token stays in memory; only
# the scoped, leased secrets reach disk (0640).
User=root
Group=root

ExecStart=/usr/bin/vault agent -config=/etc/amadeus-runner/vault/vault-agent.hcl

Restart=on-failure
RestartSec=10s

# ── Hardening ────────────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Vault Agent needs outbound TLS to Vault only.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Writable: the rendered secrets file (in the otherwise read-only /etc tree) and
# the pid file under /run. Nothing else.
ReadWritePaths=/etc/amadeus-runner
RuntimeDirectory=amadeus-vault-agent

[Install]
WantedBy=multi-user.target
