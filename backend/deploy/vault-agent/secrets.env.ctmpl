{{- /*
  Cronomicon runner secrets — rendered by Vault Agent into
  /etc/amadeus-runner/secrets.env, sourced by amadeus-runner.service.

  Each line binds a Vault KV-v2 field to an env-var NAME the runner forwards to a
  play when the inventory references {{ lookup('env','NAME') }}. Names only reach
  the play; values live only in the (0640) rendered file. Keep the NAMEs in sync
  with your inventory's lookup('env', ...) references.

  KV path below assumes a KV-v2 mount named `cronomicon` and a secret at
  `amadeus/runners/nwd` with fields `become_password`, etc. Adjust to your mount.

  Add `no_log: true` on any task that DECRYPTS/echoes these downstream — the
  Cronomicon log redactor only masks values it knows about.
*/ -}}
{{ with secret "cronomicon/data/runners/nwd" -}}
NWD_BECOME_PASS={{ .Data.data.become_password }}
{{- /* Add more NAME=field lines as needed, e.g.:
NWD_WINRM_PASS={{ .Data.data.winrm_password }}
*/ -}}
{{ end }}
