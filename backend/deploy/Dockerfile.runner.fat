# Fat runner image (R4.1 — the confirmed T-a driver): the SAME amadeus-runner
# agent PLUS the local toolchains it shells out to — ansible (+ Python) and
# terraform. ansible/terraform run ON the executor, not on the remote host, so a
# runner that claims `ansible`/`terraform` runs must carry the toolchain locally.
#
# WHY THIS IS SEPARATE from the app image and from the slim runner:
#   • The app image (backend/Dockerfile) is distroless and DELIBERATELY ships no
#     ansible/terraform — keeping the control plane minimal and toolchain-free was
#     a conscious posture (runners-update.md §4 T-a, Dockerfile:49). Putting the
#     toolchains in the app would bloat it and broaden its attack surface for a
#     capability only out-of-process workers need.
#   • The slim runner (Dockerfile.runner) covers SSH-onward shells and is a tiny
#     static/distroless image. ansible+Python+terraform add hundreds of MB and a
#     full userland; forcing every runner to carry them would defeat the point.
#   • So the toolchain lives ONLY here, on runners that declare
#     capabilities:["ansible","terraform"]. Capability routing (claimRun filters
#     run_type IN caps, R4.2) guarantees only this image claims those runs.
#
# Build context is backend/ (the Go module root). Build with:
#
#   docker build -f deploy/Dockerfile.runner.fat \
#     --build-arg VERSION=$(git describe --tags --always --dirty) \
#     --build-arg COMMIT=$(git rev-parse --short HEAD) \
#     -t amadeus-runner:fat .

# ── Stage 1: compile the agent. A static (CGO off) binary drops cleanly onto the
# Debian-slim final stage and has no glibc-version coupling.
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . ./
ARG VERSION=dev
ARG COMMIT=none
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /out/amadeus-runner ./cmd/amadeus-runner

# ── Stage 2: a real userland — the toolchains need Python, an OpenSSH client
# (ansible dials targets over ssh), and the terraform binary. We pin versions so
# the image is reproducible; bump them deliberately.
FROM debian:bookworm-slim

LABEL org.opencontainers.image.title="amadeus-runner-fat" \
      org.opencontainers.image.description="Cronomicon runner agent + ansible/terraform local toolchains" \
      org.opencontainers.image.source="https://github.com/ResetSmith/cronomicon"

ARG ANSIBLE_VERSION=10.3.0
ARG TERRAFORM_VERSION=1.9.5
ARG TARGETARCH=amd64

# ca-certificates: agent HTTPS to the server. openssh-client: ansible/onward SSH.
# python3 + pipx/pip: ansible. unzip/curl: fetch the terraform release.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates openssh-client python3 python3-pip python3-venv \
        curl unzip; \
    # ansible via pip into a venv-free system install (image is single-purpose).
    # The `ansible` meta-package pulls in the matching ansible-core + collections.
    pip3 install --no-cache-dir --break-system-packages "ansible==${ANSIBLE_VERSION}"; \
    # terraform — fetch the pinned release for the build arch and install it.
    curl -fsSL -o /tmp/terraform.zip \
        "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_${TARGETARCH}.zip"; \
    unzip -d /usr/local/bin /tmp/terraform.zip; \
    rm -f /tmp/terraform.zip; \
    # drop the fetch tools we no longer need; keep openssh-client + python.
    apt-get purge -y --auto-remove curl unzip; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    # sanity: the toolchains the agent shells out to must be on PATH.
    ansible-playbook --version; \
    terraform version

# Non-root service account (the agent never needs root).
RUN useradd --system --create-home --uid 10001 --shell /usr/sbin/nologin cronomicon

WORKDIR /app
COPY --from=build /out/amadeus-runner /app/amadeus-runner

# Identity + keys/inventory persist here (see install-runner.md).
RUN mkdir -p /var/lib/amadeus-runner && chown amadeus:cronomicon /var/lib/amadeus-runner
VOLUME ["/var/lib/amadeus-runner"]
ENV CRONOMICON_RUNNER_IDENTITY_FILE=/var/lib/amadeus-runner/identity.json

USER cronomicon
ENTRYPOINT ["/app/amadeus-runner"]
