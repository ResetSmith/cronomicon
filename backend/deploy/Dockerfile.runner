# Slim runner image (R7.1 / R4.1): the cronomicon-runner agent for the SSH-ONWARD
# use case (bash/perl/powershell against reachable or bastion-jumped targets).
#
# Unlike the app image (backend/Dockerfile), the agent imports NO cgo packages —
# it does not touch SQLite. So this builds with CGO_ENABLED=0 into a fully static
# binary and ships on distroless/static (no glibc, no shell) — the smallest,
# hardest final image we can produce.
#
# This image deliberately carries ONLY the agent. The ansible/terraform
# toolchains live in the FAT image (Dockerfile.runner.fat) because they are bulky
# and only the T-a (ansible/terraform) driver needs them; an SSH-onward runner
# (T-b network-isolated shells) does not. Keep the slim image slim.
#
# Build context is backend/ (the Go module root) — NOT the repo root the app
# image uses, because the agent embeds no frontend. Build with:
#
#   docker build -f deploy/Dockerfile.runner \
#     --build-arg VERSION=$(git describe --tags --always --dirty) \
#     --build-arg COMMIT=$(git rev-parse --short HEAD) \
#     -t cronomicon-runner:slim .
#
# (run from backend/, so the build context is backend/.)

# ── Stage 1: compile the static agent binary.
FROM golang:1.26-bookworm AS build
WORKDIR /src
# Cache modules first.
COPY go.mod go.sum* ./
RUN go mod download
COPY . ./

# Build metadata, stamped into `cronomicon-runner version`.
ARG VERSION=dev
ARG COMMIT=none
# CGO off → a static binary that runs on distroless/static.
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /out/cronomicon-runner ./cmd/cronomicon-runner

# ── Stage 2: minimal static runtime. No glibc, no shell, no package manager.
# distroless/static ships CA certificates (for the agent's HTTPS to the server)
# and the nonroot user; nothing else.
FROM gcr.io/distroless/static-debian12

LABEL org.opencontainers.image.title="cronomicon-runner" \
      org.opencontainers.image.description="Cronomicon runner agent (slim — SSH-onward, no local toolchains)" \
      org.opencontainers.image.source="https://github.com/ResetSmith/cronomicon"

WORKDIR /app
COPY --from=build /out/cronomicon-runner /app/cronomicon-runner

# Identity file + any mounted keys/known_hosts live under /var/lib/cronomicon-runner.
# Persist it (see install-runner.md "identity persistence") so a restart resumes
# the same runners row instead of orphaning it (R2.4 / D4).
VOLUME ["/var/lib/cronomicon-runner"]
ENV CRONOMICON_RUNNER_IDENTITY_FILE=/var/lib/cronomicon-runner/identity.json

# Config comes from CRONOMICON_RUNNER_* env (and/or -config file). Required at run:
#   CRONOMICON_RUNNER_SERVER, CRONOMICON_RUNNER_REGISTRATION_TOKEN,
#   CRONOMICON_RUNNER_NAME, CRONOMICON_RUNNER_CAPABILITIES.
# See deploy/install-runner.md for the full surface and worked examples.

USER nonroot:nonroot
ENTRYPOINT ["/app/cronomicon-runner"]
