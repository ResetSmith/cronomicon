# Cronomicon runtime env for the compose stack. Copy to `amadeus.env` (gitignored)
# and fill in. See env-matrix.md for the complete list + defaults.

# ── Auth: Trusted Header SSO (Phase A) ───────────────────────────────────────
CRONOMICON_AUTH_MODE=trusted-header
# Trust ONLY the proxy. In this stack Nginx Proxy Manager has the static internal IP below.
CRONOMICON_TRUSTED_PROXIES=10.0.0.0/8
CRONOMICON_LOGOUT_REDIRECT_URL=https://auth.example.com/logout
# FIRST DEPLOY ONLY — seeds the first admin, then remove this line and redeploy.
CRONOMICON_BOOTSTRAP_ADMIN_GROUP=cronomicon-admins
# Header-name overrides are optional; defaults are the conventional forward-auth names (Remote-User, Remote-Groups, etc.), as sent by Authelia and similar proxies.

# ── Cookies / TLS ─────────────────────────────────────────────────────────────
CRONOMICON_COOKIE_SECURE=true

# ── Logging ──────────────────────────────────────────────────────────────────
CRONOMICON_LOG_LEVEL=debug
CRONOMICON_LOG_FORMAT=json
# Process log on disk, IN ADDITION to stdout (stdout is never replaced, so
# journald/docker collection is unaffected). Default: amadeus.log in the run-log
# directory (Settings -> Log Storage), following it if that setting changes.
# Set CRONOMICON_LOG_FILE to an ABSOLUTE path to pin it elsewhere — that also attaches
# the file earlier in boot, so the build banner and config warnings are captured.
# Disk is bounded by (KEEP + 1) * MAX_MB = 384 MiB at these defaults. Rotated
# generations are amadeus.log.1 .. .N and are NOT reaped by
# CRONOMICON_RETENTION_LOG_FILES_DAYS — the keep count is the process-log retention.
# CRONOMICON_LOG_FILE_ENABLED=true
# CRONOMICON_LOG_FILE=/var/lib/amadeus/logs/amadeus.log
# CRONOMICON_LOG_FILE_MAX_MB=64
# CRONOMICON_LOG_FILE_KEEP=5
# Compliance audit stream (audit.log) — a SEPARATE file from the process log: one
# JSON-Lines record per audited event (change log, selected activity, all auth
# events), rotated DAILY by UTC date to audit.log.YYYYMMDD. Defaults to audit.log in
# the run-log directory; set an ABSOLUTE path to pin it. Its lifetime is the
# auditLogFiles retention knob (Settings -> Audit & Compliance, default 730 days),
# not a keep count. The database stays authoritative; the file is an export of it,
# so disabling this loses the stream, not the audit trail.
# CRONOMICON_AUDIT_LOG_ENABLED=true
# CRONOMICON_AUDIT_LOG=/var/lib/amadeus/logs/audit.log
# Cap a single run's ingested log (default 512 MiB). Log ingest is exempt from the
# 2 MiB body cap, so this bounds per-run growth against a rogue runner; further
# ingest past the cap returns 413. 0 disables the cap.
# CRONOMICON_MAX_RUN_LOG_BYTES=536870912

# ── Outbound SSRF guard (SU-7) ────────────────────────────────────────────────
# Cloud-metadata/loopback/link-local are ALWAYS blocked for operator-configured
# outbound targets (Vault, GitLab, S3, Apprise, OIDC). Private ranges are ALLOWED
# by default (internal Vault/GitLab). Set false only if every target is public.
# CRONOMICON_OUTBOUND_ALLOW_PRIVATE=true
# Re-permit loopback ONLY for a Vault-agent loopback sidecar (weakens the guard).
# CRONOMICON_OUTBOUND_ALLOW_LOOPBACK=false

# ── Stored-secret KEK (S14) — mounted file; back up SEPARATELY from S3 backup ──
# The KEK is app CONFIG, not a store secret. Names under the reserved reference
# prefixes (CRONOMICON_VAR_/SECRET_/KEY_/RUN_) are values Cronomicon injects into runs;
# everything else under CRONOMICON_* is config — hence CRONOMICON_KEK*, not
# CRONOMICON_SECRET_KEK* (that older spelling no longer reads as of v1.5.41).
CRONOMICON_KEK_FILE=/run/secrets/amadeus_kek

# ── Integrations ──────────────────────────────────────────────────────────────
# This is a TEMPLATE — never put real credentials here; copy to amadeus.env
# (gitignored) and fill in there.
# GitLab/Vault connection settings are also editable in the UI (DB-backed).
# Env, when set, OVERRIDES the DB value (see env-matrix.md §precedence); leave
# unset to manage via Settings. NOTE: while CRONOMICON_GITLAB_WEBHOOK_SECRET is
# set, the webhook-secret rotation API returns 409.
CRONOMICON_GITLAB_BASE_URL=https://gitlab.example.com/ops/job-definitions.git
CRONOMICON_GITLAB_TOKEN=
CRONOMICON_GITLAB_WEBHOOK_SECRET=
CRONOMICON_RUNNER_BOOTSTRAP_TOKEN=

# ── Retention ─────────────────────────────────────────────────────────────────
# BOOTSTRAP DEFAULTS ONLY. These seed the Audit & Compliance settings blob on the
# first boot that finds it unset; from then on the stored blob (Settings → Audit
# & Compliance, six per-table knobs) is authoritative and editing these has no
# effect. Change the windows in the UI, not here.
CRONOMICON_RETENTION_RUNS_DAYS=90
CRONOMICON_RETENTION_CHANGELOG_DAYS=365
# Reaps on-disk run logs. Before this knob existed nothing ever deleted them —
# on an upgraded deployment the first nightly sweep will delete log files older
# than this window. Set 0 to keep forever.
CRONOMICON_RETENTION_LOG_FILES_DAYS=90

# ── Backups — leave bucket empty for local-only snapshots ─────────────────────
CRONOMICON_BACKUP_S3_BUCKET=
CRONOMICON_BACKUP_S3_ENDPOINT=
CRONOMICON_BACKUP_S3_REGION=us-east-1
CRONOMICON_BACKUP_S3_ACCESS_KEY=
CRONOMICON_BACKUP_S3_SECRET_KEY=
CRONOMICON_BACKUP_S3_USE_SSL=true

# ── Dev flags: MUST stay unset in production ──────────────────────────────────
# CRONOMICON_DEV_AUTH=true
# CRONOMICON_DEV_SEED=true

# ── Notifications (Phase C.1) — Apprise gateway (the sidecar in this stack) ────
CRONOMICON_APPRISE_URL=https://apprise.example.com

# ── Vault (Phase C.3) — leave unset to keep the local-KEK secret path only.
# Set all three (addr + role + secret) to enable vault-source secrets AND SSH
# credentials (both resolve through the same client). Prefer the *_FILE forms
# (mounted secrets) over inline values in production. See deploy/vault-runbook.md.
# CRONOMICON_VAULT_ADDR=https://vault.internal:8200
# CRONOMICON_VAULT_ROLE_ID_FILE=/run/secrets/vault_role_id
# CRONOMICON_VAULT_SECRET_ID_FILE=/run/secrets/vault_secret_id
#
# Vault client hardening (Phase 2, D4) — each knob is DORMANT until set; unset
# reproduces the pre-hardening behavior exactly.
#   Namespace (Vault Enterprise / HCP): env overrides the DB vault_config.namespace.
# CRONOMICON_VAULT_NAMESPACE=admin/team-ops
#   Private CA: pin the client transport to a PEM bundle instead of system roots.
#   A missing/invalid bundle fails LOUD (Vault stays disabled) — never a silent
#   fall-back to system roots.
# CRONOMICON_VAULT_CA_FILE=/run/secrets/vault_ca.pem
#   Response-wrapped secret_id: when true, CRONOMICON_VAULT_SECRET_ID[_FILE] holds a
#   single-use wrapping token; the client unwraps it once (sys/wrapping/unwrap) and
#   caches the real secret_id in memory. Static long-lived secret_id is the default.
# CRONOMICON_VAULT_SECRET_ID_WRAPPED=false

# ── Run injection kill-switch (D5) — dispatch-time reference injection is ON by
# default: bound CRONOMICON_SECRET_/VAR_/KEY_ references resolve and inject into runs.
# Set false to hard-disable injection for a release (the plural SECRETS_ spelling
# sits OUTSIDE the reserved CRONOMICON_SECRET_* prefix, so it is config, not a value).
# CRONOMICON_SECRETS_INJECTION_ENABLED=true
